# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# Postgres connection.
# If this is not set, the API uses embedded PGlite in <repo>/.pglite (local preview only).
# For deployment use a real Postgres, e.g. Supabase with ?sslmode=require.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ielts

# API
PORT=8787
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173,https://YOUR_GITHUB_USER.github.io

# Optional: real AI feedback for Writing. Without it the API returns a
# rule-based estimate instead of failing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_HOURLY_LIMIT=20

# Public URL of the web app. Verification and password-reset emails link here.
APP_URL=http://localhost:5173

# Email delivery. SMTP takes priority over Resend when both are configured.
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=abcd efgh ijkl mnop   (16-character Google app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IELTS Practice <you@gmail.com>

# Alternative: Resend (a verified domain is required to email other people).
RESEND_API_KEY=

# Set to false to close public sign-ups.
REGISTRATION_OPEN=true

# Admin bootstrap (only read by `npm run seed:admin`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
ADMIN_NAME=Administrator
